<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Send SMS directly without opening the SMS app -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Reminder notifications (runtime-requested on API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      No CAMERA permission on purpose: prescription photos are captured by
      delegating to the system camera app via ACTION_IMAGE_CAPTURE, which needs
      no permission. Declaring CAMERA here would *create* a runtime prompt
      rather than avoid one.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <!-- Required for Android 11+ package visibility to detect WhatsApp -->
        <package android:name="com.whatsapp" />
        <!-- Resolve a camera app for prescription capture -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands camera apps a writable URI for the capture file -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WhatsApp auto-send accessibility service -->
        <service
            android:name=".autosend.WhatsAppAutoSendService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/whatsapp_auto_send_config" />
        </service>
    </application>

</manifest>
